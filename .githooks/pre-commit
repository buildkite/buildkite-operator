#!/usr/bin/env bash
# Refuses commits whose staged chart examples don't match the staged chart.
# Only the index is checked, so unstaged changes neither cause nor hide a
# mismatch. Enable with `make install-hooks`. CI runs the same check.
set -euo pipefail

chart=charts/buildkite-operator

git diff --cached --quiet -- "${chart}" && exit 0

staged=$(mktemp -d)
trap 'rm -rf "${staged}"' EXIT
git ls-files -z -- "${chart}" | git checkout-index -z --stdin --prefix="${staged}/"
cp -R "${staged}/${chart}/examples" "${staged}/examples-before"

make --no-print-directory helm-examples HELM_CHART_DIR="${staged}/${chart}"
if ! changed=$(diff -rq "${staged}/examples-before" "${staged}/${chart}/examples"); then
	echo "The staged chart examples don't match the staged chart:" >&2
	awk '/^Files / { print $2 } /^Only in / { sub(/:$/, "", $3); print $3 "/" $4 }' <<<"${changed}" |
		sed "s|^${staged}/examples-before|${chart}/examples|; s|^${staged}/||; s|^|  |" >&2
	echo "Run make helm-examples, then stage the result: git add ${chart}/examples" >&2
	exit 1
fi
