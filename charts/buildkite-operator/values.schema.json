{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["defaults", "queues", "supervisor", "deletionCost", "ociAccelerator", "agentToken", "metricsToken", "registryCredentials", "keda"],
  "properties": {
    "defaults": {
      "allOf": [
        { "$ref": "#/$defs/runnerSettings" },
        {
          "required": ["runtime", "ephemeralAgent", "minReplicas", "pollingInterval", "cooldownPeriod", "scaleDownStabilizationWindowSeconds", "terminationGracePeriodSeconds", "image", "resources", "docker"],
          "properties": {
            "image": { "required": ["repository", "tag", "pullPolicy"] },
            "docker": {
              "required": ["image", "resources", "storage", "ociAccelerator", "stepImages", "defaultStepImage", "agentRuntimeImage"],
              "properties": {
                "image": { "required": ["repository", "tag", "pullPolicy"] },
                "storage": { "required": ["data", "workspace"] }
              }
            }
          }
        }
      ]
    },
    "queues": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [{ "$ref": "#/$defs/runnerSettings" }, { "type": "null" }]
      }
    },
    "supervisor": { "$ref": "#/$defs/pinnedSidecar" },
    "deletionCost": {
      "type": "object",
      "required": ["admissionPolicy", "image", "resources"],
      "additionalProperties": false,
      "properties": {
        "admissionPolicy": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "image": { "$ref": "#/$defs/pinnedSidecar/properties/image" },
        "resources": { "type": "object" }
      }
    },
    "ociAccelerator": {
      "type": "object",
      "required": ["enabled", "registries", "noProxy", "ca", "cache", "extraEnv", "networkPolicy", "nodeSelector", "tolerations", "image", "resources"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "registries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authority" }
        },
        "noProxy": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^,\\s]+$" }
        },
        "ca": {
          "type": "object",
          "required": ["existingSecret"],
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "object",
              "required": ["name", "certificateKey", "privateKeyKey"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "certificateKey": { "type": "string", "minLength": 1 },
                "privateKeyKey": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "cache": {
          "type": "object",
          "required": ["size", "maxBytes"],
          "additionalProperties": false,
          "properties": {
            "size": { "type": "string", "minLength": 1 },
            "maxBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "extraEnv": {
          "type": "object",
          "propertyNames": { "pattern": "^OCI_ACCELERATOR_[A-Z0-9_]+$" },
          "additionalProperties": { "type": "string" }
        },
        "networkPolicy": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "image": { "$ref": "#/$defs/pinnedSidecar/properties/image" },
        "resources": { "type": "object" }
      }
    },
    "agentToken": { "$ref": "#/$defs/token" },
    "metricsToken": { "$ref": "#/$defs/token" },
    "registryCredentials": {
      "type": "object",
      "required": ["auths", "existingSecret"],
      "additionalProperties": false,
      "properties": {
        "auths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["registry", "username", "password"],
            "additionalProperties": false,
            "properties": {
              "registry": { "type": "string", "minLength": 1 },
              "username": { "type": "string", "minLength": 1 },
              "password": { "type": "string", "minLength": 1 }
            }
          }
        },
        "existingSecret": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" }
          }
        }
      }
    },
    "keda": {
      "type": "object",
      "required": ["validateInstallation"],
      "properties": {
        "validateInstallation": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "pinnedSidecar": {
      "type": "object",
      "required": ["image", "resources"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "authority": {
      "type": "string",
      "pattern": "^([A-Za-z0-9]([-A-Za-z0-9]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([-A-Za-z0-9]*[A-Za-z0-9])?)*|\\[[0-9A-Fa-f:.]+\\])(:[1-9][0-9]{0,4})?$"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "required": ["value", "existingSecret"],
      "properties": {
        "value": { "type": "string" },
        "existingSecret": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "runnerSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queue": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "runtime": { "type": "string", "enum": ["standard", "dind", "kata", "sysbox"] },
        "ephemeralAgent": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 0 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "pollingInterval": { "type": "integer", "minimum": 1 },
        "cooldownPeriod": { "type": "integer", "minimum": 0 },
        "scaleDownStabilizationWindowSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/$defs/image" },
        "resources": { "type": "object" },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": { "$ref": "#/$defs/image" },
            "resources": { "type": "object" },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "data": { "type": "string", "minLength": 1 },
                "workspace": { "type": "string", "minLength": 1 }
              }
            },
            "ociAccelerator": { "type": "boolean" },
            "stepImages": { "type": "boolean" },
            "defaultStepImage": { "type": "string" },
            "agentRuntimeImage": { "type": "string", "pattern": "^[^,\\s]*$" }
          }
        }
      }
    }
  }
}
