{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["runners", "docker", "supervisor", "deletionCost", "agentToken", "metricsToken", "keda"],
  "properties": {
    "runners": {
      "type": "object",
      "required": ["enabled", "queue", "runtime", "singleUse", "minReplicas", "maxReplicas", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "maxLength": 63 },
        "queue": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
        "runtime": { "type": "string", "enum": ["standard", "kata", "sysbox"] },
        "singleUse": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 0 },
        "maxReplicas": { "type": "integer", "minimum": 0 },
        "pollingInterval": { "type": "integer", "minimum": 1 },
        "cooldownPeriod": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "docker": {
      "type": "object",
      "required": ["image", "resources", "storage"],
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "resources": { "type": "object" },
        "storage": {
          "type": "object",
          "required": ["data", "workspace"],
          "properties": {
            "data": { "type": "string", "minLength": 1 },
            "workspace": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "supervisor": { "$ref": "#/$defs/pinnedSidecar" },
    "deletionCost": { "$ref": "#/$defs/pinnedSidecar" },
    "agentToken": { "$ref": "#/$defs/token" },
    "metricsToken": { "$ref": "#/$defs/token" },
    "keda": {
      "type": "object",
      "required": ["validateInstallation"],
      "properties": { "validateInstallation": { "type": "boolean" } }
    }
  },
  "$defs": {
    "pinnedSidecar": {
      "type": "object",
      "required": ["image", "resources"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "token": {
      "type": "object",
      "required": ["value", "existingSecret"],
      "properties": {
        "value": { "type": "string" },
        "existingSecret": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
